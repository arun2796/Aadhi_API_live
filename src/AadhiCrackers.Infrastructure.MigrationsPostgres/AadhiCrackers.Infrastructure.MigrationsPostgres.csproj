<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Migrations assembly for AadhiDbContext. PostgreSQL is the only supported provider.

    Keeping migrations in their own assembly (wired up through MigrationsAssembly in
    AadhiCrackers.Infrastructure/DependencyInjection.cs) keeps the schema history separate from the
    runtime model, so a model change is never silently applied without a migration to match.

    To add a new migration (PowerShell, from the repo root), run "dotnet ef migrations add [Name]"
    with these options (double-dash prefixed; they cannot be written literally inside an XML comment):
      project        = src/AadhiCrackers.Infrastructure.MigrationsPostgres
      startup-project = src/AadhiCrackers.Api
      output-dir     = Migrations
    with $env:ConnectionStrings__DefaultConnection set to a reachable PostgreSQL database.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AadhiCrackers.Infrastructure\AadhiCrackers.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>

</Project>
