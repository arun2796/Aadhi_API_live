# Normalize line endings.
#
# The deploy scripts are checked out on Windows but EXECUTED on Ubuntu. Without this,
# git's autocrlf would give them CRLF endings and bash on the server would fail with
# "bad interpreter: /usr/bin/env bash^M: no such file or directory".
* text=auto

*.sh            text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
deploy/*.env.example text eol=lf

*.cs            text eol=lf diff=csharp
*.csproj        text eol=lf
*.json          text eol=lf
*.md            text eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.ico binary
*.gz  binary
