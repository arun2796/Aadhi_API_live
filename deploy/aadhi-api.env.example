# =============================================================================
# Aadhi Crackers API — server environment
#
# Install as /etc/aadhi-api/aadhi-api.env, owned by root, mode 0600:
#
#   sudo install -d -m 0750 /etc/aadhi-api
#   sudo install -m 0600 /dev/null /etc/aadhi-api/aadhi-api.env
#   sudo nano /etc/aadhi-api/aadhi-api.env      # paste and fill in
#   sudo systemctl restart aadhi-api
#
# This file is the ONLY place production secrets live. It is not part of a
# release, so deploys never overwrite it. Nothing here belongs in git.
#
# systemd EnvironmentFile syntax: KEY=value, one per line, NO "export", no
# inline comments after a value, and no quotes unless they are part of the value.
# =============================================================================

# --- Hosting -----------------------------------------------------------------
# Bind to loopback only. nginx is the only thing that talks to the app, and it
# terminates TLS. Never expose Kestrel directly to the internet.
ASPNETCORE_URLS=http://127.0.0.1:5000
ASPNETCORE_ENVIRONMENT=Production
DOTNET_PrintTelemetryMessage=false

# --- Database ----------------------------------------------------------------
# PostgreSQL on this same instance, reached over the local socket/loopback.
# The password is the one set by provision-lightsail.sh (it prints it once).
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=aadhicrackers;Username=aadhi;Password=REPLACE_WITH_DB_PASSWORD

# --- JWT ---------------------------------------------------------------------
# 32+ characters. Generate one with:  openssl rand -base64 48
# Changing this logs every user out.
JwtSettings__SecretKey=REPLACE_WITH_A_LONG_RANDOM_SECRET

# --- CORS --------------------------------------------------------------------
# The frontends live on Cloudflare Pages, i.e. a DIFFERENT origin from this API,
# so they must be listed explicitly. Semicolon-separated, no trailing slash.
# Leaving this blank allows every origin — do not do that in production.
Cors__AllowedOrigins=https://aadhicracker.in;https://www.aadhicracker.in;https://adminerp.aadhicracker.in

# --- Image storage (Cloudflare R2) -------------------------------------------
# PublicBaseUrl is the origin images are SERVED from (custom domain or the
# bucket's pub-<hash>.r2.dev URL) — never the S3 API endpoint.
Storage__Provider=R2
Storage__R2__AccountId=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
Storage__R2__AccessKeyId=REPLACE_WITH_R2_ACCESS_KEY_ID
Storage__R2__SecretAccessKey=REPLACE_WITH_R2_SECRET_ACCESS_KEY
Storage__R2__BucketName=aadhicrackers
Storage__R2__PublicBaseUrl=https://pub-XXXXXXXXXXXX.r2.dev

# --- Seeding -----------------------------------------------------------------
# Demo products/customers/orders must never be created in production.
Seeding__IncludeDemoData=false
Seeding__AdminEmail=admin@aadhicracker.in
Seeding__AdminPassword=REPLACE_ON_FIRST_BOOT_THEN_CHANGE_IN_THE_APP

# --- Firebase (Google sign-in on the storefront) ------------------------------
# The project id is all the API needs: it verifies customer ID tokens against
# Google's public keys for this project. Not a secret. Must match the frontend's
# firebase.ts config (projectId) or every Google sign-in is rejected.
Firebase__ProjectId=aadhi-crackers

# --- Misc --------------------------------------------------------------------
RateLimiting__Enabled=true
